{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acme Notes",
  "identifier": "co.acme.notes",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Acme Notes",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "hud",
        "url": "/hud.html",
        "title": "Acme Notes Dictation",
        "width": 124,
        "height": 32,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "agent-hud",
        "url": "/agent-hud.html",
        "title": "Acme Notes Agents",
        "width": 240,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "meeting-hud",
        "url": "/meeting-hud.html",
        "title": "Acme Notes Recording",
        "width": 76,
        "height": 76,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["acmenotes"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["acmenotes"]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_A_BRAND_OWNED_KEY_FROM_tauri_signer_generate",
      "endpoints": [
        "https://github.com/acme/acme-notes-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "icon": [
      "../branding/example/icons/32x32.png",
      "../branding/example/icons/128x128.png",
      "../branding/example/icons/128x128@2x.png",
      "../branding/example/icons/icon.png"
    ]
  }
}
